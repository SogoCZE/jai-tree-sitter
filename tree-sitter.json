{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"name": "jai",
			"camelcase": "Jai",
			"title": "Jai",
			"scope": "source.jai",
			"path": ".",
			"file-types": [
				"jai"
			],
			"highlights": "queries/highlights.scm",
			"injections": "queries/injections.scm",
			"injection-regex": "^jai$"
		}
	],
	"metadata": {
		"version": "0.1.0",
		"license": "MIT",
		"description": "Jai grammar for tree-sitter",
		"authors": [
			{
				"name": "Patrik Smělý"
			}
		],
		"links": {
			"repository": "https://github.com/SogoCZE/tree-sitter-jai"
		}
	},
	"bindings": {
		"c": true,
		"go": false,
		"node": false,
		"python": false,
		"rust": false,
		"swift": false
	}
}
