{
	"name": "tree-sitter-jai",
	"version": "0.1.0",
	"description": "Jai grammar for tree-sitter",
	"main": "bindings/node",
	"types": "bindings/node",
	"keywords": [
		"tree-sitter-jai",
		"tree-sitter",
		"jai"
	],
	"files": [
		"grammar.js",
		"tree-sitter.json",
		"binding.gyp",
		"prebuilds/**",
		"bindings/node/*",
		"queries/*",
		"src/**"
	],
	"license": "MIT",
	"devDependencies": {
		"tree-sitter-cli": "^0.26.3"
	},
	"tree-sitter": [
		{
			"scope": "source.jai",
			"file-types": [
				"jai"
			],
			"injection-regex": "^jai$"
		}
	]
}
